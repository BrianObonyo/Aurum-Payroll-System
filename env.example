# Copy this file to .env and replace the placeholder secrets before starting.
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

NODE_ENV=development

# This app currently supports SQLite. The path may be absolute or relative to the project.
DB_PATH=./aurum_payroll.db

# Initial administrator is created once if the email does not already exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
