{
  "name": "aurum-payroll-backend",
  "version": "1.0.0",
  "description": "Payroll administration dashboard with a React frontend and Express API",
  "main": "server.js",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "nodemon server.js",
    "start": "node server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["payroll", "hr", "management", "api"],
  "author": "Brian Obonyo",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "nodemon": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
